<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.finefindus.eyedropper.Rb</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Eyedropper (Ruby)</name>
  <summary>Pick and format colors</summary>
  <developer id="io.github.finefindus">
      <name translatable="no">FineFindus</name>
  </developer>
  <update_contact>finefindus@proton.me</update_contact>
  <description>
    <p>Enter or pick a color and view it in different formats.</p>
    <p>A Ruby GTK4 / Libadwaita port of Eyedropper by FineFindus.</p>
    <p>Features</p>
    <ul>
      <li>Pick a Color</li>
      <li>Edit the viewed color in a simple HSL editor</li>
      <li>Enter a color in various formats</li>
      <li>Convert colors into other formats such as Hex, RGB, HSV, HSL, CMYK, XYZ, CIE-Lab…</li>
    </ul>
  </description>
